{
  "name": "mlabel",
  "version": "0.1.3",
  "private": true,
  "description": "MLabel — configurable local data-labeling desktop app",
  "homepage": "https://github.com/vladzaharia/mlabel#readme",
  "bugs": {
    "url": "https://github.com/vladzaharia/mlabel/issues"
  },
  "license": "MIT",
  "author": "Vlad Zaharia",
  "repository": {
    "type": "git",
    "url": "https://github.com/vladzaharia/mlabel.git"
  },
  "type": "module",
  "main": "./out/main/index.mjs",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:node": "vitest run --project node",
    "test:dom": "vitest run --project dom",
    "audit:contrast": "tsx scripts/audit-contrast.ts",
    "schema": "tsx scripts/emit-schema.ts",
    "icons": "tsx scripts/gen-icons.ts",
    "build:mac": "electron-vite build && dotenv -e .env -- electron-builder --mac",
    "build:win": "electron-vite build && electron-builder --win",
    "package:mac": "electron-builder --mac --publish always",
    "package:win": "electron-builder --win --publish always",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "electron-updater": "6.8.3",
    "jsonc-parser": "3.3.1",
    "papaparse": "5.5.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@electron-toolkit/preload": "3.0.2",
    "@electron-toolkit/utils": "4.0.0",
    "@fast-check/vitest": "0.4.1",
    "@resvg/resvg-js": "2.6.2",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/vite": "4.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/babel__core": "7.20.5",
    "@types/node": "22.20.0",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.9",
    "babel-plugin-react-compiler": "1.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv-cli": "11.0.0",
    "electron": "42.3.3",
    "electron-builder": "26.8.1",
    "electron-vite": "5.0.0",
    "fast-check": "4.8.0",
    "happy-dom": "20.10.6",
    "lefthook": "2.1.9",
    "lucide-react": "1.17.0",
    "oxfmt": "0.57.0",
    "oxlint": "1.72.0",
    "radix-ui": "1.4.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.2",
    "tsx": "4.22.4",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.1.2",
    "vitest": "4.1.9",
    "zustand": "5.0.14"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "lefthook",
      "electron-winstaller"
    ]
  }
}
