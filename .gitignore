node_modules/
out/
dist/
release/
coverage/
.superpowers/
*.log
.DS_Store
.env
.env.*
schema/*.generated.json

# Generated labeling exports (MLabel writes these next to the input file)
examples/*-output.*
examples/*-remaining.*

# A global gitignore excludes build/, but it holds packaging assets (icons,
# entitlements) that must be committed for reproducible builds.
!build/

# Local git worktrees
.worktrees/

# Docs site build output and generated content. The schema reference is
# regenerated from schema/mlabel.schema.json on every build, and the served
# schema is copied from schema/ — committing either would create a second copy
# that silently drifts. Screenshots under src/assets/shots ARE committed: they
# need a built app on macOS to capture, which the Ubuntu Pages runner can't do.
docs/dist/
docs/.astro/
docs/src/content/docs/reference/
docs/public/mlabel.schema.json
