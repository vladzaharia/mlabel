{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@core": ["./src/core/index.ts"],
      "@core/*": ["./src/core/*"],
      "@": ["./src/renderer/src"],
      "@/*": ["./src/renderer/src/*"],
      // Test-only. Mirrored in vitest.config.ts but deliberately NOT in
      // electron.vite.config.ts — nothing under test/ is ever bundled.
      "@test/*": ["./test/*"]
    }
  }
}
