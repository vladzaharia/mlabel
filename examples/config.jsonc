{
  // MLabel sample config. Point your editor at the generated JSON Schema for
  // autocomplete + validation while editing.
  "$schema": "../schema/mlabel.schema.json",
  "version": 2,

  // A field IS its type: `type` is a flat tag and each kind brings its own
  // payload key (`items`, `fields`, `values`, `choices`). Input and output
  // fields share that shape; output fields add `widget` (how it renders) and
  // `fill` (who provides the value), which are independent of each other.
  //
  // `display` may be a bare string when all you need is a caption.

  "ui": { "appTitle": { "field": "prompt" } },

  // ---------------------------------------------------------------------------
  // AI — on-device assistance. Nothing here can reach the output file.
  // ---------------------------------------------------------------------------
  //
  // A decision model answers *typed questions*: you declare the possible answers
  // here, before the model runs, and it returns a calibrated probability for
  // each. There is no prose to interpret, and it cannot answer with anything you
  // did not list.
  "ai": {
    // What the data means. Column names say what it *is*; only you can say what
    // would count as odd in it.
    "context": "Model responses to user prompts, scored by a reviewer. A response that contradicts its prompt, or a score that disagrees with the response's quality, is worth a second look.",

    // Nearby records, for comparison. An anomaly is relative: on its own a
    // record gives the model nothing to judge against. Costs prompt space on
    // every analysis, so keep it small.
    "neighbours": { "before": 2, "after": 2 },

    // Beyond these, the app always asks two questions of its own: whether the
    // record is internally inconsistent, and whether two careful people could
    // label it differently.
    "questions": [
      // Targeted at a field: the answer appears beside that value.
      {
        "id": "refusal",
        "type": "boolean",
        "field": "response",
        "ask": "Does the response refuse or deflect instead of answering?",
        "whenTrue": "it declines, hedges, or answers a different question",
        "whenFalse": "it attempts the task it was given",
      },
      // Targeted at a card: the answer appears once, on the card.
      {
        "id": "mismatch",
        "type": "boolean",
        "card": "sample",
        "ask": "Does the response fail to address its prompt?",
        // Only asked when there is a response to judge. A question that cannot
        // apply is never sent to the model, so this is also what keeps it quick.
        "when": { "op": "notEmpty", "field": "response" },
      },
      // A choice: one of a fixed set, each with its own probability.
      {
        "id": "kind",
        "type": "choice",
        "ask": "What kind of task was the prompt?",
        "options": [
          { "name": "question", "means": "asks for a fact or an explanation" },
          { "name": "generation", "means": "asks for text to be written" },
          { "name": "transform", "means": "asks for given text to be rewritten" },
          { "name": "other" },
        ],
      },
      // A score: levels weakest first. The answer is a weighted average of their
      // positions, so 1.2 means mostly "minor" with a little "clear".
      {
        "id": "severity",
        "type": "score",
        "ask": "How serious is the worst problem with this response?",
        "levels": ["none", "minor", "clear", "severe"],
        // Surface this one sooner than the default 0.7: a cheap false positive
        // is worth catching a rare real one.
        "showAbove": 0.55,
      },
    ],
  },

  // ---------------------------------------------------------------------------
  // INPUT — what is read from the source file and shown read-only.
  // ---------------------------------------------------------------------------
  "input": {
    "adapterId": "csv",
    "fields": [
      { "name": "id", "type": "text" },
      {
        "name": "prompt",
        "type": "text",
        "display": { "title": "Prompt", "titlePosition": "above", "textSize": "lg" },
      },
      {
        "name": "response",
        "type": "text",
        "display": { "title": "Model response", "titlePosition": "above" },
      },
      { "name": "model", "type": "text", "display": "Model" },
      { "name": "created", "type": "date", "display": "Created" },
      {
        "name": "score",
        "type": "number",
        "min": 0,
        "max": 1,
        "display": {
          "title": "Model score",
          "help": "The model's self-reported confidence (0–1).",
        },
      },
      { "name": "flagged", "type": "boolean", "display": "Auto-flagged" },
      { "name": "tags", "type": "array", "items": { "type": "text" }, "display": "Tags" },
      {
        "name": "tokenCounts",
        "type": "map",
        "values": { "type": "integer" },
        "display": "Token counts",
      },
      {
        "name": "checks",
        "type": "array",
        "items": {
          "type": "object",
          "fields": [
            { "name": "name", "type": "text", "display": "Check" },
            { "name": "passed", "type": "boolean", "display": "Passed" },
          ],
        },
        "display": { "title": "Safety checks", "titlePosition": "above" },
      },
      {
        "name": "annotators",
        "type": "map",
        "values": {
          "type": "object",
          "fields": [
            { "name": "role", "type": "text", "display": "Role" },
            { "name": "confidence", "type": "number", "display": "Confidence" },
          ],
        },
        "display": { "title": "Prior annotations", "titlePosition": "above" },
      },
    ],

    // Purely visual. Evaluated by a core module the export path never imports,
    // so a rule can never change what is written to disk.
    "rules": [
      {
        "name": "canned-refusal",
        "when": { "op": "matches", "field": "response", "pattern": "^(I'm sorry|As an AI)" },
        "appliesTo": ["response"],
        "style": { "tone": "muted", "note": "Canned refusal — deprioritize." },
      },
      {
        "name": "very-confident",
        "when": { "op": "gt", "field": "score", "value": 0.9 },
        "appliesTo": ["score"],
        "style": { "tone": "warning", "note": "Unusually confident — check carefully." },
      },
    ],

    "cards": [
      {
        "name": "sample",
        "display": { "title": "Sample", "description": "The prompt/response pair under review." },
        "rows": [
          { "use": ["prompt"] },
          { "use": ["response"] },
          { "perRow": 3, "use": ["model", "created", "score"] },
        ],
      },
      {
        "name": "signals",
        "display": {
          "title": "Automated signals",
          "description": "Pre-computed metadata for this sample.",
          "help": "These are produced upstream and are provided to inform your labels.",
        },
        "rows": [
          { "perRow": 2, "use": ["flagged", "tags"] },
          { "use": ["tokenCounts"] },
          { "use": ["checks"] },
        ],
      },
      {
        "name": "priors",
        "display": "Prior annotations",
        "rows": [{ "use": ["annotators"] }],
      },
    ],
  },

  // ---------------------------------------------------------------------------
  // OUTPUT — what the labeler captures (or the app fills in).
  // ---------------------------------------------------------------------------
  "output": {
    "adapterId": "csv",
    "fields": [
      // Carried over from the input column of the same name. `fill.from` would
      // let this be written under a different name.
      { "name": "id", "type": "text", "fill": { "kind": "copy" } },
      {
        "name": "sentiment",
        "type": "enum",
        "widget": "radio",
        "choices": [
          { "name": "positive", "display": "Positive" },
          { "name": "neutral", "display": "Neutral" },
          { "name": "negative", "display": "Negative", "selectedStyle": { "tone": "danger" } },
        ],
        "display": "Sentiment",
      },
      {
        "name": "quality",
        "type": "enum",
        "choices": [
          { "name": "high", "display": "High" },
          { "name": "medium", "display": "Medium" },
          { "name": "low", "display": "Low" },
        ],
        "display": "Quality",
      },
      {
        "name": "needsReview",
        "type": "boolean",
        "required": false,
        "display": "Needs human review",
      },
      {
        "name": "rating",
        "type": "integer",
        "widget": "slider",
        "min": 1,
        "max": 5,
        "step": 1,
        "display": "Overall rating",
      },
      {
        "name": "confidence",
        "type": "number",
        "required": false,
        "min": 0,
        "max": 1,
        "step": 0.1,
        "display": "Your confidence",
      },
      { "name": "reviewedOn", "type": "date", "required": false, "display": "Reviewed on" },
      {
        "name": "notes",
        "type": "text",
        "widget": "textarea",
        "required": false,
        "maxLength": 500,
        "display": { "title": "Notes", "titlePosition": "above" },
      },
    ],
    "cards": [
      {
        "name": "labels",
        "display": "Labels",
        "rows": [{ "perRow": 2, "use": ["sentiment", "quality"] }, { "use": ["needsReview"] }],
      },
      {
        "name": "scores",
        "display": "Scores",
        "rows": [{ "perRow": 2, "use": ["rating", "confidence"] }],
      },
      {
        "name": "meta",
        "display": "Review",
        "rows": [{ "perRow": 2, "use": ["reviewedOn", "notes"] }],
      },
    ],
  },
}
